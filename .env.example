# fylgja-core's environment: the names, never a value.
#
# Copy this file to local/.env (git-ignored, mode 0600) and fill it in. Fylgja reads the
# process environment only, never a file: load it with `set -a; . local/.env; set +a`.
# No package, blueprint, bundle, finding, record or log line ever holds a value
# (Constitution X). Never print, log or persist a token or a password.

# The core's API address for a client, host:port or an http(s):// URL.
FYLGJA_API_ADDRESS=

# A client's bearer token. Make one with `head -c 24 /dev/urandom | base64`; the server holds
# its hash, with the client's principal, in the token file FYLGJA_TOKENS names (D-025,
# CONTRIBUTING.md "Running the core").
FYLGJA_API_TOKEN=
# The CA file an https:// address is verified against; unset, the system's trust (D-063).
FYLGJA_API_CA=

# Node logins. A platform package names a credential (`credentials: srlinux`), and the
# local credential provider reads FYLGJA_CREDENTIAL_<NAME>_USERNAME and _PASSWORD, NAME
# being that value upper-cased with dashes as underscores (D-042). Each image's documented
# default login is enough for a twin.
FYLGJA_CREDENTIAL_SRLINUX_USERNAME=
FYLGJA_CREDENTIAL_SRLINUX_PASSWORD=
FYLGJA_CREDENTIAL_EOS_USERNAME=
FYLGJA_CREDENTIAL_EOS_PASSWORD=
# A pull credential, for a package's `pull_secret` on the clabernetes driver: the image prefix
# (a host, an optional port and an optional path, no scheme) and the registry login (D-057, D-062).
FYLGJA_CREDENTIAL_ARISTA_CEOS_REGISTRY=
FYLGJA_CREDENTIAL_ARISTA_CEOS_USERNAME=
FYLGJA_CREDENTIAL_ARISTA_CEOS_PASSWORD=

# The server's settings (D-042), read from the process environment alone.
# Where the store keeps blueprints, bundles, twins and runs: a directory, or
# `s3://<bucket>[/<prefix>]` on an S3 endpoint that honours conditional writes (D-061).
FYLGJA_STORE=
# For an object store: the endpoint's URL, its access key and secret key, the region signed
# for (default `us-east-1`), and a CA bundle for an `https://` endpoint a private CA signed
# (default the system's).
FYLGJA_S3_ENDPOINT=
FYLGJA_S3_ACCESS_KEY=
FYLGJA_S3_SECRET_KEY=
FYLGJA_S3_REGION=
FYLGJA_S3_CA=
# The Lease in the core's namespace that holds the store for one core; required by s3:// (D-062).
FYLGJA_LEASE=
# host:port the server listens on; default 127.0.0.1:7650.
FYLGJA_LISTEN=
# The certificate the server serves TLS with; set with FYLGJA_TLS_KEY, or neither for HTTP (D-063).
FYLGJA_TLS_CERT=
# The certificate's key; set with FYLGJA_TLS_CERT, or neither for HTTP (D-063).
FYLGJA_TLS_KEY=
# The driver that runs twins, containerlab or clabernetes; default containerlab.
FYLGJA_DRIVER=
# The clabernetes driver's site, both required when it is the driver (D-057): clabernetes'
# namespace, a DNS-1123 label (c9s, say), and the cluster's pod network as an IPv4 CIDR
# (10.244.0.0/16, say), which each twin's policy names.
FYLGJA_CLABERNETES_NAMESPACE=
FYLGJA_POD_CIDR=
# The cluster tier, and a core run off the cluster on the clabernetes driver, reach the cluster
# through the kubeconfig file KUBECONFIG names; a core run as a pod uses its service account.
# Left unset here: an empty KUBECONFIG loaded by `set -a` would override the shell's own.
# KUBECONFIG=/path/to/kubeconfig

# How many operations run at once; default 8.
FYLGJA_WORKERS=
# Seconds a step waits for verify to hold before it ends anyway; default 180 (D-050).
FYLGJA_STEP_WAIT_S=
# Seconds between the loop's resyncs, each queueing every twin again, so a runtime event missed
# is only late; default 300 (D-023, D-058).
FYLGJA_RESYNC_S=
# Colon-separated directories of platform and probe packages.
FYLGJA_PACKAGES=
# The file of token hashes and principals (D-025); it never holds a token itself.
FYLGJA_TOKENS=

# The conformance suite's cluster harness (`make conformance DRIVER=clabernetes`) drives the
# deployed core: it reads KUBECONFIG, and FYLGJA_API_ADDRESS (an https:// URL), FYLGJA_API_TOKEN
# and FYLGJA_API_CA above, the core's; the label selector of the core's pod
# (app.kubernetes.io/name=fylgja-core, say); and the core's namespace, default fylgja (D-062).
FYLGJA_CONFORMANCE_SELECTOR=
FYLGJA_CONFORMANCE_NAMESPACE=
