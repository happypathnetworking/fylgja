# Fylgja environment. scripts/bring-up.sh scaffolds local/.env (git-ignored) from these
# names, every value made or filled in, when the file is absent; without the script, copy
# this file there and fill it in.
#
# Fylgja reads these from the process environment, never from a file: a tool that
# reads .env from the working directory will one day read the wrong one. Source it
# yourself (`set -a; . local/.env; set +a`), or use direnv.
#
# local/.env is the only file that holds a value. This file documents the names and
# carries no value, ever, and neither does any package, snapshot, bundle, finding, record
# or log line (Constitution X).
#
# One binary runs in three roles, and each reads its own variables (D-040, D-041):
# `fylgja serve` and `fylgja worker run` on the lab host, and every other command, a
# client of the server, on the operator's machine or the lab host. A client reads the
# API's two variables below and nothing else; every variable after them is the server's
# and the worker's.

# --- The API ----------------------------------------------------------------------------

# The API's address, as host:port, or an http:// or https:// URL for a proxy the
# operator runs. Default 127.0.0.1:7650. Read by a client alone: the server listens
# where each `fylgja serve --listen` says, by default the same address (D-042), and on the
# lab host on the Docker bridge as well (D-050; docs/development.md). Infrahub's
# task workers, where the checks fylgja-step and fylgja-twin run as clients, get
# host.docker.internal:7650 from scripts/infrahub/docker-compose.override.yml, never this
# value, since loopback reaches nothing from a container; the override gives them
# FYLGJA_API_TOKEN from this file, through Compose's --env-file (D-050).
FYLGJA_API_ADDRESS=

# The API's token, sent by a client and compared by the server; the server refuses to
# start without it. Read by a client and the server, never the worker. Never printed,
# logged or persisted (Constitution X). Make one with, for example,
# `head -c 24 /dev/urandom | base64`.
FYLGJA_API_TOKEN=

# --- The server and the worker; never a client ------------------------------------------

# Infrahub's address. Infrahub is operator-provided; Fylgja neither vendors nor
# starts it (docs/development.md). Read by the server alone: never the worker, which reads
# no source of truth (D-062), and never a client.
INFRAHUB_ADDRESS=

# Infrahub API token. Never persisted, never echoed, never in a bundle or a
# finding (Constitution X). Read by the server alone: never the worker (D-062), and never
# a client.
INFRAHUB_API_TOKEN=

# The scope a request that names none is read under, tag:<name>: the devices carrying the
# tag of that name (017). twin create, twin rehearse, intent read, stage plan and stage
# list take --scope in its place, and the checks fylgja-step and fylgja-twin send none.
# Unset or empty, the server starts and reports no default, and refuses such a request
# scope.unset; a value that is not tag:<name> refuses its start. scripts/bring-up.sh
# scaffolds tag:fylgja, the fixture's tag. Read by the server alone, at its start: never
# the worker, which reads no intent, and never a client.
FYLGJA_DEFAULT_SCOPE=

# Optional: a directory of platform support packages that overrides the embedded
# ones, package by package (D-016). Also settable as --psp-dir, a flag of
# `fylgja serve` and `fylgja worker run` alone. Read by the server and the worker, never
# a client.
FYLGJA_PSP_DIR=

# Workflow service host:port. Default localhost:7233, the dev server (make temporal-dev).
# Read by the server and the worker, never a client.
FYLGJA_TEMPORAL_ADDRESS=

# Temporal namespace. Default `default`. Read by the server and the worker, never a
# client.
FYLGJA_TEMPORAL_NAMESPACE=

# State root holding bundles/, snapshots/ and twin/. Default `local` under the working
# directory.
# Read by the server and the worker, never a client.
FYLGJA_STATE_ROOT=

# Optional: MiB the twin may use on this host; unset, the host check only warns.
# Read by the server and the worker, never a client.
FYLGJA_HOST_MEMORY_MB=

# SR Linux readiness-probe and configuration-push username: the image's
# published default. The names are psp/nokia_srlinux.yaml's readiness.login and
# config.push.login data, not code. Read by the server and the worker, never a client.
FYLGJA_SRLINUX_USERNAME=

# SR Linux readiness-probe and configuration-push password. Never printed, logged or
# persisted (Constitution X). Read by the server and the worker, never a client.
FYLGJA_SRLINUX_PASSWORD=

# Arista EOS (cEOS) readiness-probe and eAPI-push username: the image's published
# default. The names are psp/arista_eos.yaml's data in the same way, so a twin with no
# EOS node never asks for these, and the host check refuses one that does when they are
# unset. Read by the server and the worker, never a client.
FYLGJA_EOS_USERNAME=

# Arista EOS readiness-probe and eAPI-push password. Never printed, logged or
# persisted (Constitution X). Read by the server and the worker, never a client.
FYLGJA_EOS_PASSWORD=

# --- Infrahub's Compose; never Fylgja -----------------------------------------------------

# Read by Infrahub's Compose (`docker compose --env-file local/.env`), never by Fylgja.
# scripts/bring-up.sh makes each one when it scaffolds local/.env. The published Compose
# file carries a default for every one of them, readable by anyone in that file: a host
# that kept them would run Infrahub under public credentials, so none may be kept.

# The Compose project Infrahub runs as: fylgja-infrahub.
COMPOSE_PROJECT_NAME=

# Infrahub's initial admin token, a UUID. INFRAHUB_API_TOKEN carries the same value.
# Never printed, logged or persisted elsewhere (Constitution X).
INFRAHUB_INITIAL_ADMIN_TOKEN=

# Infrahub's initial admin password, for its web UI. Never printed, logged or persisted
# elsewhere.
INFRAHUB_INITIAL_ADMIN_PASSWORD=

# The token of Infrahub's task worker, a UUID. Never printed, logged or persisted
# elsewhere.
INFRAHUB_INITIAL_AGENT_TOKEN=

# The key Infrahub signs its sessions with. Never printed, logged or persisted elsewhere.
INFRAHUB_SECURITY_SECRET_KEY=
