# Fylgja environment. scripts/bring-up.sh scaffolds local/.env (git-ignored) from these
# names, every value made or filled in, when the file is absent; without the script, copy
# this file there and fill it in.
#
# Fylgja reads these from the process environment, never from a file: a tool that
# reads .env from the working directory will one day read the wrong one. Source it
# yourself (`set -a; . local/.env; set +a`), or use direnv.
#
# local/.env is the only file that holds a value. This file documents the names and
# carries no value, ever, and neither does any package, snapshot, bundle, finding, record
# or log line (Constitution X).
#
# Two deployables read them (D-065). The core is one binary in three roles (D-040, D-041):
# `fylgja serve` and `fylgja worker run` on the lab host, and every other `fylgja` command,
# a client of the server, on the operator's machine or the lab host. The orchestrator
# (orchestrator/.venv, `make orchestrator-venv`) runs as `fylgja-cli`, the commands that
# name a branch or a stage, each running its flow in its own process; as the runner,
# `fylgja-orchestrator serve`, which serves the six flows' deployments to the checks; and
# beside them the Prefect server, the platform the runner and the checks meet on. Each
# reads its own variables, named below; the orchestrator's flows are the core's clients, so
# they read the API's two as well.

# --- The API: the core's clients ----------------------------------------------------------

# The API's address, as host:port, or an http:// or https:// URL for a proxy the
# operator runs. Default 127.0.0.1:7650. Read by a client alone, `fylgja`'s and the
# orchestrator's flows: the server listens where each `fylgja serve --listen` says, by
# default the same address, loopback alone (D-042), and the development host starts it so
# (020's FR-005). Infrahub's task workers never reach the core: the checks fylgja-step and
# fylgja-twin are clients of the orchestrator's platform, which the override points them at
# (FYLGJA_ORCHESTRATOR_ADDRESS, scripts/infrahub/docker-compose.override.yml).
FYLGJA_API_ADDRESS=

# The API's token, sent by a client and compared by the server; the server refuses to
# start without it. Read by a client, the orchestrator's flows among them, and the server,
# never the worker. It never crosses the Docker bridge. Never printed, logged or persisted
# (Constitution X). Make one with, for example, `head -c 24 /dev/urandom | base64`.
FYLGJA_API_TOKEN=

# --- The orchestrator; never the core -----------------------------------------------------

# Infrahub's address. Infrahub is operator-provided; Fylgja neither vendors nor
# starts it (docs/development.md). Read by the orchestrator, `fylgja-cli` and the runner's
# flows, through its adapter, and by the fixture tool and the contract tier: never the
# core's server, worker or client, which read no source of truth (D-065).
INFRAHUB_ADDRESS=

# Infrahub API token. Never persisted, never echoed, never in a snapshot, a bundle or a
# finding (Constitution X). Read where INFRAHUB_ADDRESS is, never by the core (D-065).
INFRAHUB_API_TOKEN=

# The scope a read that names none is read under, tag:<name>: the devices carrying the tag
# of that name (017). fylgja-cli's twin create, twin rehearse, intent read, stage plan and
# stage list take --scope in its place, and the checks fylgja-step and fylgja-twin send
# none, so the runner's value scopes them. Unset or empty, such a read is refused
# scope.unset; a value that is not tag:<name> is refused too. scripts/bring-up.sh
# scaffolds tag:fylgja, the fixture's tag. Read by the orchestrator, `fylgja-cli` and the
# runner's flows, at each read: never the core, which reads no intent (D-065).
FYLGJA_DEFAULT_SCOPE=

# The orchestrator's state root, holding its twin record (twin.json) and its snapshots/.
# Default `local/orchestrator` under the working directory; scripts/bring-up.sh scaffolds
# it absolute. Read by `fylgja-cli` and the runner, never the core, whose state root is
# FYLGJA_STATE_ROOT.
FYLGJA_ORCHESTRATOR_ROOT=

# The orchestrator's platform, the Prefect server's API: http://<bridge>:4200/api, the
# host's Docker bridge address, where the server listens, one listener the host's
# processes and Infrahub's task workers both reach (research R-01). Read by `fylgja-cli`
# and the runner, as Prefect's own client setting, and by `make prefect-server` and
# scripts/bring-up.sh for the server's host and port. Unset, `fylgja-cli` runs its flows
# on Prefect's ephemeral server under PREFECT_HOME, as tier 3 does, and the runner refuses
# to start, having no one to serve. Never the core.
PREFECT_API_URL=

# The platform's basic authentication, <user>:<password>. Read by `fylgja-cli` and the
# runner, whose Prefect client sends it, and given to the Prefect server as its
# PREFECT_SERVER_API_AUTH_STRING by `make prefect-server` and scripts/bring-up.sh. Carries
# FYLGJA_ORCHESTRATOR_AUTH's value. Never printed, logged or persisted elsewhere
# (Constitution X); never the core.
PREFECT_API_AUTH_STRING=

# The same <user>:<password>, for the checks: read by Infrahub's Compose (`--env-file
# local/.env`), which gives it to the task workers through
# scripts/infrahub/docker-compose.override.yml beside FYLGJA_ORCHESTRATOR_ADDRESS,
# host.docker.internal:4200, where fylgja-step and fylgja-twin send it to the platform.
# Never read by the core or by the orchestrator's processes on the host. scripts/bring-up.sh
# makes it, `fylgja:` and a random password, when it scaffolds local/.env. Never printed,
# logged or persisted elsewhere (Constitution X).
FYLGJA_ORCHESTRATOR_AUTH=

# --- The core's server and worker; never a client -----------------------------------------

# Optional: a directory of platform support packages that overrides the embedded
# ones, package by package (D-016). Also settable as --psp-dir, a flag of
# `fylgja serve` and `fylgja worker run` alone. Read by the server and the worker, never
# a client, and by the orchestrator's adapter, which matches platforms by the same
# packages.
FYLGJA_PSP_DIR=

# Workflow service host:port. Default localhost:7233, the dev server (make temporal-dev).
# Read by the server and the worker, never a client.
FYLGJA_TEMPORAL_ADDRESS=

# Temporal namespace. Default `default`. Read by the server and the worker, never a
# client.
FYLGJA_TEMPORAL_NAMESPACE=

# State root holding bundles/, snapshots/ and twin/. Default `local` under the working
# directory.
# Read by the server and the worker, never a client.
FYLGJA_STATE_ROOT=

# Optional: MiB the twin may use on this host; unset, the host check only warns.
# Read by the server and the worker, never a client.
FYLGJA_HOST_MEMORY_MB=

# SR Linux readiness-probe and configuration-push username: the image's
# published default. The names are psp/nokia_srlinux.yaml's readiness.login and
# config.push.login data, not code. Read by the server and the worker, never a client.
FYLGJA_SRLINUX_USERNAME=

# SR Linux readiness-probe and configuration-push password. Never printed, logged or
# persisted (Constitution X). Read by the server and the worker, never a client.
FYLGJA_SRLINUX_PASSWORD=

# Arista EOS (cEOS) readiness-probe and eAPI-push username: the image's published
# default. The names are psp/arista_eos.yaml's data in the same way, so a twin with no
# EOS node never asks for these, and the host check refuses one that does when they are
# unset. Read by the server and the worker, never a client.
FYLGJA_EOS_USERNAME=

# Arista EOS readiness-probe and eAPI-push password. Never printed, logged or
# persisted (Constitution X). Read by the server and the worker, never a client.
FYLGJA_EOS_PASSWORD=

# --- Infrahub's Compose; never Fylgja -----------------------------------------------------

# Read by Infrahub's Compose (`docker compose --env-file local/.env`), never by Fylgja.
# scripts/bring-up.sh makes each one when it scaffolds local/.env. The published Compose
# file carries a default for every one of them, readable by anyone in that file: a host
# that kept them would run Infrahub under public credentials, so none may be kept.

# The Compose project Infrahub runs as: fylgja-infrahub.
COMPOSE_PROJECT_NAME=

# Infrahub's initial admin token, a UUID. INFRAHUB_API_TOKEN carries the same value.
# Never printed, logged or persisted elsewhere (Constitution X).
INFRAHUB_INITIAL_ADMIN_TOKEN=

# Infrahub's initial admin password, for its web UI. Never printed, logged or persisted
# elsewhere.
INFRAHUB_INITIAL_ADMIN_PASSWORD=

# The token of Infrahub's task worker, a UUID. Never printed, logged or persisted
# elsewhere.
INFRAHUB_INITIAL_AGENT_TOKEN=

# The key Infrahub signs its sessions with. Never printed, logged or persisted elsewhere.
INFRAHUB_SECURITY_SECRET_KEY=
