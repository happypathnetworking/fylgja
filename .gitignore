# Local, machine-specific state (see docs/development.md)
local/

# Build output
bin/
dist/

# Python bytecode, which py_compile leaves beside infrahub/checks/
__pycache__/

# Go test and profiling artifacts
*.test
*.out
*.prof
coverage.*

# Claude Code per-user overrides
.claude/settings.local.json

# Spec Kit machine-local feature pointer
.specify/feature.json

# Editors and OS
*.swp
*.swo
*~
.idea/
.vscode/
.DS_Store

# The command log is local in this repository: the hooks write it, make command-log
# publishes it here, and nothing commits it (docs/development.md).
commands/
specs/*/commands/

# Spec Kit's own files, installed on each host by `specify init --here --integration claude
# --script sh` and not redistributed here (MIT, GitHub, Inc.; D-056). The constitution, the
# amended plan template, the overrides directory (this repository's templates, which Spec
# Kit's resolver prefers to its own) and extensions.yml are this repository's and stay
# tracked.
.claude/skills/speckit-*/
.specify/scripts/
.specify/templates/*
!.specify/templates/plan-template.md
!.specify/templates/overrides/
.specify/integrations/
.specify/workflows/
.specify/init-options.json
.specify/integration.json
.specify/memory/.constitution-template.json
.specify/extensions/
.specify/.gitignore
