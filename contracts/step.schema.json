{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fylgja.dev/schemas/step.schema.json",
  "title": "fylgja twin step — the step block (M11 FR-002, FR-015; M12 FR-021)",
  "description": "The `step` block of the findings document fylgja twin step emits (operation twin.step), on the dry run and on the run. The two sides, M10's step between their bundles (waypoints.schema.json $defs/step), containerlab's dry-run plan with each touched node's package declaration beside what containerlab reported, the push plan with each node's reasons, and, once a run closed, the step run, its outcome, the phase that failed, each push's outcome, the timings and when it started and ended. No device diff, artifact or bootstrap content, token or login (FR-029). M12 (FR-021): wait, the step's waiting form after the record: budget_s on the dry run and before the run closed; outcome, reads, after_s and failing once the run closed and the wait ran; absent when the run was cancelled before the wait began (data-model §7.3).",
  "$defs": {
    "waypoint": {
      "type": ["object", "null"],
      "required": ["series", "sequence", "description", "at_source"],
      "additionalProperties": false,
      "properties": {
        "series": { "type": "string", "pattern": "^[^/\\s]+$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "at_source": { "enum": ["given", "written"] }
      }
    },
    "side": {
      "type": "object",
      "required": ["waypoint", "bundle_id", "at"],
      "additionalProperties": false,
      "properties": {
        "waypoint": { "$ref": "#/$defs/waypoint" },
        "bundle_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "at": { "type": "string", "description": "the side's pinned at, verbatim" },
        "branch": { "type": "string", "description": "the target's branch; absent on the from side" }
      }
    },
    "reconcile": {
      "type": "object",
      "description": "clab deploy --dry-run --format json over the target topology, read with the twin directory's lab state (research R9.1, R9.4), with the packages' fidelity.link_change beside it",
      "required": ["added", "deleted", "recreated", "restarted", "links_added", "endpoints_deleted", "nodes"],
      "additionalProperties": false,
      "properties": {
        "added": { "type": "array", "items": { "type": "string" } },
        "deleted": { "type": "array", "items": { "type": "string" } },
        "recreated": { "type": "array", "items": { "type": "string" } },
        "restarted": { "type": "array", "items": { "type": "string" } },
        "links_added": { "type": "array", "items": { "type": "string" } },
        "endpoints_deleted": { "type": "array", "items": { "type": "string" } },
        "nodes": {
          "type": "array",
          "description": "every node a link change touches or a lifecycle list names",
          "items": {
            "type": "object",
            "required": ["node", "declared", "reported"],
            "additionalProperties": false,
            "properties": {
              "node": { "type": "string" },
              "declared": { "type": ["string", "null"], "enum": ["restart", "live", null] },
              "reported": { "enum": ["restart", "recreate", "create", "live"] },
              "reason": { "type": "string" }
            }
          }
        },
        "skipped": { "type": "boolean", "description": "on a run: true when nothing was applied: the plan was empty, or the step was unchanged and its run skipped the reconcile (the lists still containerlab's plan as read)" },
        "took_s": { "type": "number", "minimum": 0 }
      }
    },
    "push_plan_entry": {
      "type": "object",
      "required": ["node", "reasons"],
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string" },
        "reasons": { "type": "array", "minItems": 1, "items": { "enum": ["artifact", "bootstrap", "restarted", "recreated", "created"] } }
      }
    },
    "pushed_entry": {
      "type": "object",
      "required": ["node", "reasons", "outcome"],
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string" },
        "reasons": { "type": "array", "minItems": 1, "items": { "enum": ["artifact", "bootstrap", "restarted", "recreated", "created"] } },
        "outcome": { "enum": ["landed", "refused", "failed", "not_attempted"] },
        "rule": { "type": "string" },
        "took_s": { "type": "number", "minimum": 0 }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reconcile_s": { "type": "number", "minimum": 0 },
        "readiness": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "push": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "whole_s": { "type": "number", "minimum": 0 }
      }
    },
    "step": {
      "type": "object",
      "required": ["from", "to", "diff", "reconcile", "push_plan", "allow_restart"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/side" },
        "to": { "$ref": "#/$defs/side" },
        "diff": { "$ref": "https://fylgja.dev/schemas/waypoints.schema.json#/$defs/step" },
        "reconcile": { "$ref": "#/$defs/reconcile" },
        "push_plan": { "type": "array", "items": { "$ref": "#/$defs/push_plan_entry" } },
        "allow_restart": { "type": "boolean" },
        "run": {
          "type": "object",
          "required": ["workflow_id", "run_id"],
          "additionalProperties": false,
          "properties": { "workflow_id": { "const": "fylgja-step" }, "run_id": { "type": "string" } }
        },
        "outcome": { "enum": ["stepped", "unchanged", "diverged"] },
        "phase": { "enum": ["reconcile", "readiness", "push", "record"] },
        "state": { "enum": ["ready", "diverged"] },
        "pushed": { "type": "array", "items": { "$ref": "#/$defs/pushed_entry" } },
        "ready_after": { "type": "array", "items": { "type": "object", "required": ["node", "ready_after_s"], "additionalProperties": false, "properties": { "node": { "type": "string" }, "ready_after_s": { "type": "number", "minimum": 0 } } } },
        "timings": { "$ref": "#/$defs/timings" },
        "started_at": { "type": "string" },
        "ended_at": { "type": "string" },
        "wait": {
          "type": "object",
          "description": "M12 (FR-021): the step's wait, verify's waiting form after the record. On the dry run and before the run closed, budget_s alone; once the run closed and the wait ran, how it ended. Absent when the run was cancelled before the wait began (the record's step.wait is then null). settled: every assertion read from a node held; expired: the budget passed with every node read and an assertion failing; cancelled: the run was cancelled during the wait; incomplete: a node unread at expiry, or the activity failed",
          "required": ["budget_s"],
          "additionalProperties": false,
          "properties": {
            "budget_s": { "type": "integer", "minimum": 0 },
            "outcome": { "enum": ["settled", "expired", "cancelled", "incomplete"] },
            "reads": { "type": "integer", "minimum": 0 },
            "after_s": { "type": "number", "minimum": 0, "description": "seconds from the record to the read that settled, or to the wait's end otherwise" },
            "failing": { "type": "array", "items": { "type": "object", "required": ["rule", "object", "message"], "additionalProperties": false, "properties": { "rule": { "type": "string" }, "object": { "type": "string" }, "message": { "type": "string" } } }, "description": "the assertions still failing at the last read, and an unread node's operation.failed; [] when settled; never content" }
          }
        }
      }
    }
  }
}
