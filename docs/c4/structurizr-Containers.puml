@startuml
title <size:24>Container View: Fylgja</size>\n<size:24>Fylgja's processes and files on the lab host, and what each reaches.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

AddElementTag("Container,Files", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Person", $bgColor="#08427b", $borderColor="#052e56", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Container", $bgColor="#438dd5", $borderColor="#2e6295", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Software System,External", $bgColor="#999999", $borderColor="#6b6b6b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = "")

AddBoundaryTag("Software System", $bgColor="#ffffff", $borderColor="#0b4884", $fontColor="#0b4884", $shadowing="", $borderStyle="solid")

Person(Operator, "Operator", $descr="Owns the lab host and Infrahub; drives the twin through the CLI.", $tags="Person", $link="")
System(Infrahub, "Infrahub", $descr="The network source of truth. Holds intent on branches, versioned in time, and renders each device's configuration artifact.", $tags="Software System,External", $link="")

System_Boundary("Walkingtwin_boundary", "Walking twin", $tags="Software System") {
  Container(Walkingtwin.NOSnode, "NOS node", $techn="Container", $descr="One device of the twin, clab-fylgja-<node>: SR Linux or EOS, probed and read over gNMI and pushed its artifact.", $tags="Container", $link="")
}

System_Boundary("Fylgja_boundary", "Fylgja", $tags="Software System") {
  Container(Fylgja.fylgjaworkerrun, "fylgja worker run", $techn="Go, the same binary", $descr="The lab-host worker: runs the workflows and the host-bound activities.", $tags="Container", $link="")
  Container(Fylgja.Workflowservice, "Workflow service", $techn="Temporal", $descr="Durable execution: run history, Schedule fylgja-follow.", $tags="Container", $link="")
  ContainerDb(Fylgja.Bundlestore, "Bundle store", $techn="Files", $descr="<state root>/bundles/<bundle_id>/: every bundle compiled or provisioned.", $tags="Container,Files", $link="")
  ContainerDb(Fylgja.Twindirectory, "Twin directory", $techn="Files", $descr="<state root>/twin/: the staged bundle, containerlab's directory, twin.json.", $tags="Container,Files", $link="")
  Container(Fylgja.containerlab, "containerlab", $techn="CLI", $descr="Deploys, reconciles, inspects and destroys lab fylgja.", $tags="Container", $link="")
  Container(Fylgja.fylgjaclient, "fylgja (client)", $techn="Go, one static binary", $descr="Every command but the two roles. Sends one request to the API and prints what comes back.", $tags="Container", $link="")
  Container(Fylgja.fylgjaserve, "fylgja serve", $techn="Go, the same binary; HTTP on 127.0.0.1:7650", $descr="The API's server, on the lab host. Reads Infrahub, compiles, checks the host, starts and follows runs, reads the twin.", $tags="Container", $link="")
}

Rel(Operator, Infrahub, "Edits intent; writes waypoints", $techn="", $tags="Relationship", $link="")
Rel(Operator, Fylgja.fylgjaclient, "Runs commands", $techn="", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaclient, Fylgja.fylgjaserve, "POST /v1/<noun>/<verb>; bearer token", $techn="HTTP, NDJSON", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaserve, Infrahub, "Reads intent and artifacts", $techn="GraphQL, REST", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaserve, Fylgja.Workflowservice, "Starts, follows, cancels runs", $techn="gRPC", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaserve, Fylgja.Bundlestore, "Files and reads bundles", $techn="", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaserve, Fylgja.Twindirectory, "Reads the record and the staged bundle", $techn="", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaserve, Fylgja.containerlab, "Inspects; dry runs", $techn="", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaserve, Walkingtwin.NOSnode, "Reads for verify", $techn="gNMI", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaworkerrun, Fylgja.Workflowservice, "Polls task queue fylgja", $techn="gRPC", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaworkerrun, Infrahub, "Reads intent and artifacts", $techn="GraphQL, REST", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaworkerrun, Fylgja.Bundlestore, "Files and reads bundles", $techn="", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaworkerrun, Fylgja.Twindirectory, "Stages, records", $techn="", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaworkerrun, Fylgja.containerlab, "Deploys, reconciles, destroys", $techn="", $tags="Relationship", $link="")
Rel(Fylgja.fylgjaworkerrun, Walkingtwin.NOSnode, "Probes; pushes the artifact; waits", $techn="gNMI; JSON-RPC or eAPI", $tags="Relationship", $link="")
Rel(Fylgja.containerlab, Walkingtwin.NOSnode, "Creates and cables", $techn="", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml