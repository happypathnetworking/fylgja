@startuml
title <size:24>System Context View: Fylgja</size>\n<size:24>The operator, Fylgja's two deployables, Infrahub, the artifacts repository and the walking twin.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

AddElementTag("Software System", $bgColor="#1168bd", $borderColor="#0b4884", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Person", $bgColor="#08427b", $borderColor="#052e56", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")
AddElementTag("Software System,External", $bgColor="#999999", $borderColor="#6b6b6b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid")

AddRelTag("Relationship", $textColor="#444444", $lineColor="#444444", $lineStyle = "")

Person(Operator, "Operator", $descr="Owns the lab host and Infrahub; drives the twin through the two CLIs, fylgja and fylgja-cli.", $tags="Person", $link="")
System(Infrahub, "Infrahub", $descr="The network source of truth. Holds intent on branches, versioned in time, in OpsMill's schema library's DCIM, which this repository vendors at 26336e9 (schema/dcim/), beside Fylgja's two kinds, the stage and the probe (schema/fylgja-stage.yaml, schema/fylgja-probe.yaml), both on the default branch; renders each device's configuration artifact.", $tags="Software System,External", $link="")
System(Artifactsrepository, "Artifacts repository", $descr="This repository, registered in Infrahub read-only: the artifacts template (.infrahub.yml, infrahub/templates/) that renders each device's configuration from the schema library's kinds (the DcimDevice by name, its DcimPlatform and manufacturer, its InterfacePhysical ports, their addresses and their DcimCables), and beside it the two checks (infrahub/checks/) that start a proposed change's plan and its rehearsal on the orchestrator's platform.", $tags="Software System,External", $link="")
System(Walkingtwin, "Walking twin", $descr="Lab fylgja: a running containerlab topology of real network operating system images, built from one snapshot, and two synthesized hosts for each probe it declares.", $tags="Software System", $link="")
System(Fylgja, "Fylgja", $descr="Two deployables (D-065): the core compiles a snapshot into a deterministic bundle, boots it as a twin and pushes each device's production configuration; the orchestrator reads intent from Infrahub into that snapshot, resolves a proposed change's stages and rehearses them, and drives the core through its API alone.", $tags="Software System", $link="")

Rel(Operator, Fylgja, "Runs commands", $techn="", $tags="Relationship", $link="")
Rel(Operator, Infrahub, "Edits intent; opens proposed changes and marks stages", $techn="", $tags="Relationship", $link="")
Rel(Fylgja, Infrahub, "Reads intent, artifacts, stages and probes; posts a rehearsal's report", $techn="GraphQL, REST", $tags="Relationship", $link="")
Rel(Fylgja, Walkingtwin, "Boots, probes, pushes, reads", $techn="", $tags="Relationship", $link="")
Rel(Infrahub, Artifactsrepository, "Clones; renders the template; runs the checks", $techn="", $tags="Relationship", $link="")
Rel(Infrahub, Fylgja, "Runs fylgja-step and fylgja-twin, which start the plan's flow and the rehearsal's on the orchestrator's platform", $techn="HTTP, basic auth, plaintext", $tags="Relationship", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml