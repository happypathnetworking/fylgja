{#- Production configuration for one device, rendered by Infrahub from the schema library's
    DCIM (017), in the dialect of the device's platform: EOS CLI when the platform is EOS,
    SR Linux CLI otherwise, a device with no platform included, so that the pipeline never
    fails on one (Fylgja's read refuses it). A reference transform: it renders the physical
    ports alone, each with its far end, its admin state and its addresses (016), and no
    virtual interface and no routing: two addressed ports of one device reach each other by
    connected routes, two devices do not. EOS gets `ip routing` once when any port is
    addressed, since cEOS forwards nothing without it, and a second address of a port is
    `secondary`, since a plain one replaces the first. Deterministic: ports are emitted in
    name order, a port's addresses in value order. Nothing here is invented: every line
    follows from the device, its platform and manufacturer, its ports, their cables and
    their addresses. -#}
{% set dev = data.DcimDevice.edges[0].node -%}
{% set p = dev.platform.node -%}
{% set m = p.manufacturer.node if p else none -%}
{% set platform = p.name.value if p else '' -%}
{% set about = ((m.name.value if m else '') ~ ' ' ~ platform) | trim -%}
{% set about = about ~ (('; ' ~ dev.description.value) if dev.description.value else '') -%}
{% set l3 = namespace(addressed=false) -%}
{% for edge in dev.interfaces.edges if edge.node['__typename'] == 'InterfacePhysical' and edge.node.role.value != 'management' and edge.node.ip_addresses.edges -%}
{% set l3.addressed = true -%}
{% endfor -%}
{% if platform == 'EOS' -%}
! {{ dev.name.value }}: production configuration rendered by Infrahub (fylgja-artifacts)
! platform {{ about }}
hostname {{ dev.name.value }}
{% if l3.addressed -%}
ip routing
{% endif -%}
{% for edge in dev.interfaces.edges | sort(attribute='node.name.value') if edge.node['__typename'] == 'InterfacePhysical' -%}
{% set i = edge.node -%}
{% if i.role.value == 'management' -%}
! {{ i.name.value }}: out-of-band management, left to the platform
{% else -%}
{% set ns = namespace(peer=none) -%}
{% if i.connector.node -%}
{% for ep in i.connector.node.connected_endpoints.edges -%}
{% if ep.node.device.node.name.value != dev.name.value or ep.node.name.value != i.name.value -%}
{% set ns.peer = ep.node -%}
{% endif -%}
{% endfor -%}
{% endif -%}
interface {{ i.name.value }}
{% if ns.peer -%}
   description to {{ ns.peer.device.node.name.value }} {{ ns.peer.name.value }}
{% endif -%}
   {{ 'shutdown' if i.status.value == 'disabled' else 'no shutdown' }}
{% if i.ip_addresses.edges -%}
   no switchport
{% for a in i.ip_addresses.edges | sort(attribute='node.address.value') -%}
   ip address {{ a.node.address.value }}{{ ' secondary' if not loop.first else '' }}
{% endfor -%}
{% endif -%}
{% endif -%}
{% endfor -%}
{% else -%}
# {{ dev.name.value }}: production configuration rendered by Infrahub (fylgja-artifacts)
# platform {{ about }}
set / system name host-name {{ dev.name.value }}
set / network-instance default type default
{% for edge in dev.interfaces.edges | sort(attribute='node.name.value') if edge.node['__typename'] == 'InterfacePhysical' -%}
{% set i = edge.node -%}
{% if i.role.value == 'management' -%}
# {{ i.name.value }}: out-of-band management, left to the platform
{% else -%}
{% set ns = namespace(peer=none) -%}
{% if i.connector.node -%}
{% for ep in i.connector.node.connected_endpoints.edges -%}
{% if ep.node.device.node.name.value != dev.name.value or ep.node.name.value != i.name.value -%}
{% set ns.peer = ep.node -%}
{% endif -%}
{% endfor -%}
{% endif -%}
{% if ns.peer -%}
set / interface {{ i.name.value }} description "to {{ ns.peer.device.node.name.value }} {{ ns.peer.name.value }}"
{% endif -%}
set / interface {{ i.name.value }} admin-state {{ 'disable' if i.status.value == 'disabled' else 'enable' }}
set / interface {{ i.name.value }} subinterface 0 admin-state enable
{% if i.ip_addresses.edges -%}
set / interface {{ i.name.value }} subinterface 0 ipv4 admin-state enable
{% for a in i.ip_addresses.edges | sort(attribute='node.address.value') -%}
set / interface {{ i.name.value }} subinterface 0 ipv4 address {{ a.node.address.value }}
{% endfor -%}
{% endif -%}
set / network-instance default interface {{ i.name.value }}.0
{% endif -%}
{% endfor -%}
{% endif -%}
