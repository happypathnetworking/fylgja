{#- One device's SR Linux configuration, rendered by Golden Config from the names the query fylgja-sotagg gives it
    (nautobot/seed/sotagg.graphql), and from no other: Golden Config spreads the query's device as names, so the
    device's name is the query's hostname and its comments the query's description. The installed Default Settings
    name this file by the platform's network driver, nokia_srl. It renders every port in the order of its name as a
    string: the management port as a comment, left to the platform; every other port with its far end where it is
    cabled, its admin state, its one subinterface, its addresses in the order of their values as strings, and its
    place in the default network-instance. A port's far end is the query's cable_peer_interface, which named the far
    port and its device at once after the cable's create (design/verified-facts.md, "Nautobot 3.2.8 with Golden
    Config 3.0.8"). Every line follows from the device, its platform and manufacturer, its ports, their cables and
    their addresses, and nothing is added. -#}
{% set manufacturer = platform.manufacturer if platform else none -%}
{% set about = ((manufacturer.name if manufacturer else '') ~ ' ' ~ (platform.name if platform else '')) | trim -%}
# {{ hostname }}: production configuration rendered by Golden Config (fylgja-templates)
# platform {{ about }}{{ ('; ' ~ description) if description else '' }}
set / system name host-name {{ hostname }}
set / network-instance default type default
{% for port in interfaces | sort(attribute='name', case_sensitive=true) -%}
{% if port.mgmt_only -%}
# {{ port.name }}: out-of-band management, left to the platform
{% else -%}
{% if port.cable_peer_interface -%}
set / interface {{ port.name }} description "to {{ port.cable_peer_interface.device.name }} {{ port.cable_peer_interface.name }}"
{% endif -%}
set / interface {{ port.name }} admin-state {{ 'enable' if port.enabled else 'disable' }}
set / interface {{ port.name }} subinterface 0 admin-state enable
{% set addresses = port.ip_addresses | map(attribute='address') | map('string') | sort(case_sensitive=true) | list -%}
{% if addresses -%}
set / interface {{ port.name }} subinterface 0 ipv4 admin-state enable
{% for address in addresses -%}
set / interface {{ port.name }} subinterface 0 ipv4 address {{ address }}
{% endfor -%}
{% endif -%}
set / network-instance default interface {{ port.name }}.0
{% endif -%}
{% endfor -%}
